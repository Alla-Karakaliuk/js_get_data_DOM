'use strict';
var populationSpans = document.querySelectorAll('.population');
var populationData = [];
populationSpans.forEach(function(element) {
    var textValue = element.textContent.trim();
    var convertedNumber = Number(textValue.replace(/,/g, ''));
    populationData.push(convertedNumber);
});
var totalPopulation = populationData.filter(function(item) {
    return typeof item === 'number' && !isNaN(item);
}).reduce(function(sum, current) {
    return sum + current;
}, 0);
var averagePopulation = Math.round(totalPopulation / populationData.length);
